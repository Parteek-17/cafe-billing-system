# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Safe to expose to the browser. Guarded by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY. Bypasses Row Level Security completely.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---------------------------------------------------------------------------
# Café business day
# ---------------------------------------------------------------------------
# The server decides which business date an order belongs to — never the
# device clock. With DAY_START_HOUR=5, an order placed at 00:20 still counts
# towards the previous day's takings.
# Timezone is used for display too, so it must be public. Not a secret.
NEXT_PUBLIC_CAFE_TIMEZONE=Asia/Kolkata
# Server-only: an order before this hour counts towards the previous day.
CAFE_DAY_START_HOUR=5
